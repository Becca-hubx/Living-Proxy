{
  "manifest_version": 3,
  "name": "Living Proxy",
  "short_name": "Living Proxy",
  "description": "Быстрое переключение прокси. Живая тема, сезонные эффекты, умные исключения.",
  "version": "7.0",
  "author": "Beccalviso",
  "homepage_url": "https://github.com/Becca-hubx/Living-Proxy",
  "minimum_chrome_version": "130",
  "offline_enabled": false,
  "permissions": ["proxy", "storage", "notifications"],
  "host_permissions": ["https://api.github.com/*"],
  "icons": {
    "16": "icons/icon_off.png",
    "32": "icons/icon_off.png",
    "48": "icons/icon_off.png",
    "128": "icons/icon_off.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Proxy",
    "default_icon": {
      "16": "icons/icon_off.png",
      "32": "icons/icon_off.png",
      "48": "icons/icon_off.png",
      "128": "icons/icon_off.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}